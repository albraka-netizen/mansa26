        "https://images.unsplash.com/photo-1609639643505-3c158a56de42?q=80&w=1412&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
    ];

    let currentImgIndex = 0;
    const imgElement = document.getElementById('main-dynamic-slide');

    function changeImage() {
        // تأثير تلاشي بسيط قبل تغيير الصورة
        imgElement.style.opacity = 0;

        setTimeout(() => {
            // الانتقال للصورة التالية في المصفوفة
            currentImgIndex = (currentImgIndex + 1) % images.length;
            imgElement.src = images[currentImgIndex];
            
            // إعادة ظهور الصورة
            imgElement.style.opacity = 1;
        }, 1200); // الوقت يتناسب مع transition الموجود في الـ CSS الخاص بك
    }

    // تغيير الصورة كل 5 ثواني
    setInterval(changeImage, 5000);



    
