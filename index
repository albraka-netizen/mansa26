    renderShowcaseCategory('homecare', 'all'); 
    renderShowcaseCategory('meats', 'all');  
}

// مصفوفة لتخزين حالة "عرض المزيد" لكل قسم (هل هو مفتوح أم مغلق)
const showcaseLimitsState = {
    dairy: false,
    vegetables: false,
    grocery: false,
    bakery: false,
    sweets: false,
    homecare: false,
    meats: false
};

// الدالة الأساسية المحدثة لضمان استقرار وتناسق الصور والكروت عند النزول لأسفل
function renderShowcaseCategory(catKey, subFilter) {
    const container = document.getElementById(`container-${catKey}`);
    if(!container) return;
    
    container.innerHTML = '';
    
    const rawProducts = storeProductsDatabase[catKey] || [];
    const filtered = rawProducts.filter(item => subFilter === 'all' || item.sub === subFilter);

    // حد العرض المبدئي للمنتجات
    const initialLimit = 2; 
    const isExpanded = showcaseLimitsState[catKey];
    
    const productsToRender = isExpanded ? filtered : filtered.slice(0, initialLimit);

    productsToRender.forEach(prod => {
        // تم إضافة تنسيقات حماية مدمجة للصورة (aspect-ratio و object-fit) لضمان الترتيب الهندسي الفوري
        const cardHTML = `
            <div class="premium-product-card" style="display: flex; flex-direction: column; height: 100%;">
                <div style="width: 100%; aspect-ratio: 4/3; background-color: #f3f4f6; overflow: hidden; border-radius: 8px; position: relative;">
                    <img src="${prod.img}" alt="${prod.name}" loading="lazy" 
                         style="width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.3s ease;"
                         onerror="this.src='https://placehold.co/400x300/0f766e/ffffff?text=البركة'">
                </div>
                <h4>${prod.name}</h4>
                <div class="card-footer" style="margin-top: auto;">
                    <span class="price-tag">${prod.price.toFixed(2)} ₪</span>
                    <button class="circle-add-btn" onclick="animateAndAddProduct(event, ${prod.id}, '${prod.name}', ${prod.price})">+</button>
                </div>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', cardHTML);
    });

    // تشغيل زر عرض المزيد أسفل الحاوية لكل قسم بشكل هندسي صحيح
    manageShowMoreButton(catKey, filtered.length, initialLimit);
}
// 2. دالة التحكم ببناء زر عرض المزيد هندسياً خارج شبكة المنتجات لمنع الخربطة
function manageShowMoreButton(catKey, totalItems, limit) {
    // إزالة الزر القديم المكرر إن وجد لمنع تراكم الأزرار
    let btnRow = document.getElementById(`btn-row-${catKey}`);
    if (btnRow) btnRow.remove();

    // إذا كان عدد منتجات القسم 4 أو أقل، لا داعي لظهور الزر نهائياً
    if (totalItems <= limit) return;

    const isExpanded = showcaseLimitsState[catKey];
    const remainingItems = totalItems - limit;

    const container = document.getElementById(`container-${catKey}`);
    if (!container) return;

    // بناء الزر الأخضر الزمردي بتصميم متزن ومستقل بمنتصف الصفحة
    const buttonHTML = `
        <div id="btn-row-${catKey}" style="width: 100%; text-align: center; margin: 30px auto 15px auto; display: block; clear: both; position: relative; z-index: 40;">
            <button class="category-toggle-btn" style="padding: 12px 40px; font-weight: 900; font-size: 14px; border-radius: 50px; cursor: pointer; transition: all 0.3s ease; border: none;" 
                    onclick="handleShowMoreClick('${catKey}')">
                ${isExpanded ? 'عرض أقل ⬆️' : `عرض المزيد (+${remainingItems}) ⬇️`}
            </button>
        </div>
    `;
    
    // حقن الزر بعد انتهاء شبكة الجريد تماماً لضمان عدم حدوث أي تشويه بصري
    container.after(document.createRange().createContextualFragment(buttonHTML));
}

// 3. دالة معالجة النقر والصعود الانسيابي المنظم لأعلى القسم
function handleShowMoreClick(catKey) {
    if (showcaseLimitsState[catKey] === undefined) return;

    // حفظ حالة القسم قبل التبديل
    const wasExpanded = showcaseLimitsState[catKey];
    
    // قلب الحالة برمجياً (المفتوح يغلق والمغلق يفتح)
    showcaseLimitsState[catKey] = !showcaseLimitsState[catKey];
    
    // قراءة الفلتر الفرعي النشط حالياً بمتجرك للمحافظة على تصفية الزبون
    let currentActiveSub = 'all';
    const sectionElement = document.getElementById(`container-${catKey}`);
    if (sectionElement && sectionElement.parentElement) {
        const activeSubBtn = sectionElement.parentElement.querySelector('.filter-btn.active');
        if (activeSubBtn) {
            const onclickAttr = activeSubBtn.getAttribute('onclick');
            if (onclickAttr) {
                const matches = onclickAttr.match(/'([^']+)'/g);
                if (matches && matches.length >= 2) {
                    currentActiveSub = matches[1].replace(/'/g, ''); 
                }
            }
        }
    }
    
    // إعادة بناء القسم فوراً بالتعديلات الجديدة
    renderShowcaseCategory(catKey, currentActiveSub);
    
    // إذا ضغط العميل على "عرض أقل"، نعود بالشاشة بنعومة لأعلى الفئة نفسها دون أي قفز عشوائي
    if (wasExpanded && sectionElement) {
        const parentWrapper = sectionElement.parentElement;
        if (parentWrapper) {
            setTimeout(() => {
                const offsetPosition = parentWrapper.getBoundingClientRect().top + window.pageYOffset - 120;
                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
            }, 50); // تأخير بسيط جداً لضمان اكتمال تقلص الصفحة أولاً
        }
    }
}
// 1. دالة تصفية الأقسام الفرعية عند النقر على الأزرار الداخلية
function filterCategoryProducts(btnElement, catKey, subKey) {
    // إرجاع القسم لوضع "عرض المزيد" الطبيعي عند تبديل الفلاتر الفرعية
    if (showcaseLimitsState[catKey] !== undefined) {
        showcaseLimitsState[catKey] = false;
    }

    const parent = btnElement.parentElement;
    const buttons = parent.querySelectorAll('.filter-btn');
    buttons.forEach(b => b.classList.remove('active'));
    btnElement.classList.add('active');
    renderShowcaseCategory(catKey, subKey);
}

// 2. دالة الانتقال السلس المطور للأقسام السبعة العلوية (تم إصلاحها بالكامل)
function smoothScrollTo(elementId) {
    const targetElement = document.getElementById(elementId);
    if (targetElement) {
        window.scrollTo({ 
            top: targetElement.offsetTop - 100, 
            behavior: 'smooth' 
        });
    }
}

// 3. الدالة المسؤولة عن التركيز والتنقل من القائمة العلوية (تم تصحيح القوس المعطل)
function focusAndFilterAnchor(anchorId, catKey) {
    const targetElement = document.getElementById(anchorId);
    if (targetElement) {
        // حساب موقع القسم البرمجي مع ترك مسافة علوية للهيدر الثابت
        const headerOffset = 130; 
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        
        window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
        });
    }

    // تصفير حالة "عرض المزيد" للفئة لتبدأ بشكل مرتب للزبون عند الانتقال إليها
    if (showcaseLimitsState[catKey] !== undefined) {
        showcaseLimitsState[catKey] = false;
        renderShowcaseCategory(catKey, 'all');
    }
}

function toggleCartMenu(shouldOpen) {
    const sidebar = document.getElementById('sidebarCart');
    const overlay = document.getElementById('cartOverlay');
    if (shouldOpen) {
        sidebar.classList.add('open'); overlay.classList.add('active');
    } else {
        sidebar.classList.remove('open'); overlay.classList.remove('active');
    }
}

function animateAndAddProduct(event, id, name, price) {
    const btnElement = event.currentTarget;
    const basketBtn = document.getElementById('main-basket-btn');
    
    if (btnElement && basketBtn) {
        const productCard = btnElement.closest('.premium-product-card');
        let imgStyle = '';
        if (productCard) {
            const productImg = productCard.querySelector('img');
            if (productImg) imgStyle = `background-image: url('${productImg.src}');`;
        }

        const btnRect = btnElement.getBoundingClientRect();
        const basketRect = basketBtn.getBoundingClientRect();

        const startX = btnRect.left;
        const startY = btnRect.top;
        const endX = basketRect.left;
        const endY = basketRect.top;

        const flyer = document.createElement('div');
         flyer.className = 'flying-product-premium';
        flyer.setAttribute('style', `top: ${startY}px; left: ${startX}px; ${imgStyle}`);
        document.body.appendChild(flyer);

        requestAnimationFrame(() => {
            flyer.style.transform = `translate(${endX - startX}px, ${endY - startY}px) scale(0.15) rotate(720deg)`;
            flyer.style.opacity = '0.3';
        });

        flyer.addEventListener('transitionend', () => { flyer.remove(); });
    }

    // 1. إضافة المنتج إلى مصفوفة السلة
    const match = userCartList.find(item => item.id === id);
    if (match) match.qty += 1;
    else userCartList.push({ id: id, name: name, price: price, qty: 1 });

    // 2. حساب إجمالي عدد المنتجات في السلة حالياً
    const totalItemsCount = userCartList.reduce((sum, item) => sum + item.qty, 0);

    // 3. تحديث العدادات قسرياً في جميع الأشكال المحتملة للـ الـ IDs بملفك:
    const counters = [
        'main-basket-count',  // العداد داخل زر السلة العائم/الرئيسي
        'cartCountBadge',     // شارة العدد العلوية
        'cart-count',         // عداد كلاسيكي
        'basket-count'        // عداد إضافي
    ];
    
    counters.forEach(idName => {
        const el = document.getElementById(idName);
        if (el) {
            el.innerText = totalItemsCount;
        }
    });

    // 4. استدعاء دالة التحديث الأصلية وحفظ السلة في الذاكرة
    if (typeof refreshCartInterface === 'function') {
        refreshCartInterface();
    } else {
        // حماية إضافية: إذا كانت الدالة الأصلية باسم آخر، نقوم بحفظ السلة في الذاكرة مباشرة هنا
        if (typeof saveCartToLocalStorage === 'function') {
            saveCartToLocalStorage();
        }
    }
}

// =========================================================
// 1. الدالة المفقودة المسؤولة عن طباعة المنتجات وحساب الأسعار بالسلة
// =========================================================
function refreshCartInterface() {
    // قراءة الحاويات الصحيحة من كود الـ HTML الخاص بك
    const cartItemsContainer = document.getElementById('cart-items-list-container');
    const cartTotalElement = document.getElementById('cart-total-amount');
    const mainBasketCount = document.getElementById('main-basket-count');

    // تحديث العداد العلوي الصغير في السلة
    const totalItemsCount = userCartList.reduce((sum, item) => sum + item.qty, 0);
    if (mainBasketCount) {
        mainBasketCount.innerText = totalItemsCount;
    }

    // حفظ أي تغيير في ذاكرة المتصفح فوراً
    saveCartToLocalStorage();

    if (!cartItemsContainer) return;
    cartItemsContainer.innerHTML = '';

    let totalPriceSum = 0;

    // حالة السلة فارغة
    if (!userCartList || userCartList.length === 0) {
        cartItemsContainer.innerHTML = `
            <div style="text-align: center; padding: 40px 20px; color: #94a3b8; font-family: 'Cairo';">
                <span style="font-size: 40px; display: block; margin-bottom: 10px;">🛒</span>
                <p style="margin: 0; font-size: 14px; font-weight: 700;">سلتك فارغة حالياً</p>
            </div>
        `;
        if (cartTotalElement) cartTotalElement.innerText = "0.00";
        return;
    }

    // طباعة كروت المنتجات داخل السلة الجانبية برسم هندسي مريح للهواتف
    userCartList.forEach(item => {
        const itemTotal = item.price * item.qty;
        totalPriceSum += itemTotal;

        const itemHTML = `
            <div class="cart-premium-item" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 8px; border-bottom: 1px solid #f3f4f6; direction: rtl; font-family: 'Cairo';">
                <div style="flex: 1; text-align: right; padding-left: 10px;">
                    <h5 style="margin: 0; font-size: 13px; font-weight: 700; color: #1f2937;">${item.name}</h5>
                    <span style="font-size: 12px; color: #0f766e; font-weight: 700;">${item.price.toFixed(2)} ₪</span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; background: #e5e7eb; padding: 4px 10px; border-radius: 30px;">
                    <button onclick="changeCartQty(${item.id}, -1)" style="border: none; background: none; font-size: 16px; font-weight: bold; cursor: pointer; color: #4b5563; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">-</button>
                    <span style="font-size: 13px; font-weight: 900; color: #111827; min-width: 15px; text-align: center;">${item.qty}</span>
                    <button onclick="changeCartQty(${item.id}, 1)" style="border: none; background: none; font-size: 14px; font-weight: bold; cursor: pointer; color: #4b5563; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;">+</button>
                </div>
                <div style="min-width: 70px; text-align: left; font-size: 13px; font-weight: 900; color: #1f2937;">
                    ${itemTotal.toFixed(2)} ₪
                </div>
            </div>
        `;
        cartItemsContainer.insertAdjacentHTML('beforeend', itemHTML);
    });

    // تحديث المجموع الإجمالي بالأسفل
    if (cartTotalElement) {
        cartTotalElement.innerText = totalPriceSum.toFixed(2);
    }
}

// =========================================================
// 2. دالة التحكم بتعديل الكميات (+ أو -) والحذف التلقائي عند الوصول لـ صفر
// =========================================================
function changeCartQty(id, change) {
    const match = userCartList.find(item => item.id === id);
    if (match) {
        match.qty += change;
        if (match.qty <= 0) {
            userCartList = userCartList.filter(item => item.id !== id);
        }
        refreshCartInterface();
    }
}

// =========================================================
// 3. دوالي الحفظ والاستعادة التلقائية من ذاكرة الهاتف المحلية (LocalStorage)
// =========================================================
function saveCartToLocalStorage() {
    localStorage.setItem('albaraka_cart', JSON.stringify(userCartList));
}

function loadCartFromLocalStorage() {
    const savedCart = localStorage.getItem('albaraka_cart');
    if (savedCart) {
        userCartList = JSON.parse(savedCart);
        refreshCartInterface();
    }
}

