    document.body.insertAdjacentHTML('beforeend', modalHTML);

    const modalElement = document.getElementById('albaraka-sky-modal');
    const modalCard = modalElement.querySelector('div');
    const submitBtn = document.getElementById('modal-submit-btn');
    const closeBtn = document.getElementById('modal-close-btn');
    const locationBtn = document.getElementById('geo-location-btn');
    const locationStatus = document.getElementById('geo-status');

    requestAnimationFrame(() => {
        modalElement.style.opacity = '1';
        modalCard.style.transform = 'translateY(0)';
    });

    const closeModal = () => {
        modalElement.style.opacity = '0';
        modalCard.style.transform = 'translateY(20px)';
        setTimeout(() => modalElement.remove(), 400);
    };

    closeBtn.addEventListener('click', closeModal);

    // التقاط الموقع وبناء الرابط العالمي لـ Waze
    locationBtn.addEventListener('click', () => {
        if (!navigator.geolocation) {
            locationStatus.style.display = "block";
            locationStatus.style.color = "#ef4444";
            locationStatus.innerHTML = "❌ متصفحك لا يدعم تحديد الموقع الجغرافي تلقائياً.";
            return;
        }

        locationStatus.style.display = "block";
        locationStatus.style.color = "#a16207";
        locationStatus.innerHTML = "⏳ جاري تحديد موقعك بالـ GPS لتجهيز خريطة Waze...";

        navigator.geolocation.getCurrentPosition(
            (position) => {
                customerLat = position.coords.latitude;
                customerLon = position.coords.longitude;
                
                // الصيغة العالمية الأكثر أماناً والمدعومة داخل محادثات واتساب لفتح التطبيق مباشرة
                customerWazeURL = `https://www.waze.com/ul?ll=${customerLat},${customerLon}&navigate=yes`;
                
                locationBtn.style.background = "rgba(132, 204, 22, 0.23)";
                locationBtn.style.borderColor = "#84cc16";
                locationBtn.style.color = "#166534";
                locationBtn.innerHTML = "✅ تم ربط موقعك بتطبيق Waze بنجاح!";
                
                locationStatus.style.color = "#166534";
                locationStatus.innerHTML = "🚙 الموقع جاهز ومربوط الآن بالخريطة المرورية الفورية.";
            },
            (error) => {
                locationStatus.style.display = "block";
                locationStatus.style.color = "#ef4444";
                if (error.code === error.PERMISSION_DENIED) {
                    locationStatus.innerHTML = "⚠️ يرجى تفعيل الـ GPS والسماح للمتصفح بالوصول لموقعك.";
                } else {
                    locationStatus.innerHTML = "❌ تعذر التقاط الإحداثيات، يرجى المحاولة مرة أخرى.";
                }
            },
            { enableHighAccuracy: true, timeout: 10000 }
        );
    });

    submitBtn.addEventListener('click', () => {
        const nameInput = document.getElementById('modal-cust-name');
        const customerName = nameInput.value.trim();

        if (customerName === "") {
            nameInput.style.borderColor = "#ef4444";
            nameInput.style.background = "#fef2f2";
            nameInput.focus();
            return;
        }

        if (customerWazeURL === "") {
            locationBtn.style.borderColor = "#ef4444";
            locationBtn.style.background = "rgba(254, 242, 242, 0.8)";
            locationStatus.style.display = "block";
            locationStatus.style.color = "#ef4444";
            locationStatus.innerHTML = "⚠️ خطوة إجبارية: يرجى الضغط على زر الموقع أولاً!";
            return;
        }

        // إطلاق فقاعة العوم الصفراء العريضة
        modalCard.style.transition = 'all 0.3s ease';
        modalCard.style.opacity = '0';
        modalCard.style.transform = 'scale(0.7)';

        const bubbleHTML = `
            
                <div style="background: linear-gradient(135deg, #eab308, #ca8a04); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #451a03; font-size: 14px; box-shadow: 0 4px 10px rgba(234,179,8,0.2);"></div>
                <span>تم ربط الـ Waze والطلب! طيران إلى WhatsApp... </span>
            </div>
        `;

        setTimeout(() => {
            modalElement.insertAdjacentHTML('beforeend', bubbleHTML);
        }, 150);

        const storeWhatsAppNumber = "972524310286"; 
        let messageText = `*طلب جديد من متجر البركة الإلكتروني *\n\n`;
        messageText += ` *اسم الزبون:* ${customerName}\n`;
        // 1. رابط الـ Waze الأول (الرابط العالمي للمتصفحات والمحادثات)
        messageText += ` *رابط الخريطة الأساسي (Waze):* ${customerWazeURL}\n`;
        // 2. الرابط العميق المباشر (مجبر للهواتف لفتح التطبيق قسرياً)
        messageText += `📱 *رابط فتح التطبيق مباشرة:* waze://?ll=${customerLat},${customerLon}&navigate=yes\n`;
        // 3. نسخة احتياطية من الإحداثيات الصافية للنسخ واللصق الطارئ
        messageText += `🔢 *الإحداثيات الجغرافية:* \`${customerLat},${customerLon}\`\n`;
        messageText += `-----------------------------------\n\n`;
        messageText += `🛒 *تفاصيل المشتريات:*\n`;

        let finalTotal = 0;
        userCartList.forEach((item, index) => {
            const itemTotal = item.price * item.qty;
            finalTotal += itemTotal;
            messageText += `${index + 1}) *${item.name}*\n     الكمية: [ ${item.qty} ] ✖️ السعر: ${item.price.toFixed(2)} ₪ ⬅️ *${itemTotal.toFixed(2)} ₪*\n`;
        });

        messageText += `\n-----------------------------------\n`;
        messageText += `💰 *الإجمالي النهائي للطلب:* [ *${finalTotal.toFixed(2)} ₪* ]\n\n`;
        messageText += `🚙 _اضغط على أحد الروابط أعلاه لفتح تطبيق الـ Waze والتوجيه فوراً._`;

        const encodedMessage = encodeURIComponent(messageText);
        const whatsappURL = `https://api.whatsapp.com/send?phone=${storeWhatsAppNumber}&text=${encodedMessage}`;
        
        userCartList = [];
        if (typeof saveCartToLocalStorage === 'function') saveCartToLocalStorage();
        if (typeof refreshCartInterface === 'function') refreshCartInterface();
        if (typeof toggleCartMenu === 'function') toggleCartMenu(false);

       // تأخير الانتقال لـ 2.5 ثانية (2500 مللي ثانية) لكي تظهر الفقاعة وتتحرك بوضوح
setTimeout(() => {
    window.location.href = whatsappURL;
    modalElement.remove();
}, 2500);
    });
}

document.addEventListener("DOMContentLoaded", function () {
    // 1. تحديد جميع الروابط أو الأزرار داخل المنيو الجانبي الخاص بك
    const menuLinks = document.querySelectorAll('.side-menu-ul li a, [class*="menu-ul"] li a, [class*="side-menu"] ul li a');

    menuLinks.forEach(link => {
        link.addEventListener('click', function (e) {
            // منع السلوك الافتراضي مؤقتاً للتحكم الكامل بالحركة
            e.preventDefault();

            // قراءة النص الموجود داخل الزر لمعرفة أين يريد العميل الذهاب
            const linkText = this.textContent.trim();

            // 2. خريطة الانتقال الذكية (ربط نص الزر بالـ ID الفعلي للقسم في صفحتك)
            let targetSectionId = '';

            if (linkText.includes('اتصل') || linkText.includes('تواصل') || linkText.includes('الدعم')) {
                targetSectionId = 'services-anchor-box'; // أو الـ ID الفعلي لقسم اتصل بنا لديك مثل contact أو footer
            } else if (linkText.includes('الرئيسية') || linkText.includes('المتجر')) {
                targetSectionId = 'main-container'; // اسم الهيدر أو أعلى الصفحة
            } else if (linkText.includes('خضار') || linkText.includes('فواكه')) {
                targetSectionId = 'showcase'; // اسم قسم المنتجات أو الفئات لديك
            } else if (linkText.includes('طلباتي')) {
                targetSectionId = 'orders'; // قسم الطلبات السابقة إذا كان متوفراً
            }

            // 3. تنفيذ الانتقال البرمجي الدقيق فوراً
            if (targetSectionId) {
                const targetElement = document.getElementById(targetSectionId);
                if (targetElement) {
                    // الانتقال السلس والمباشر إلى القسم المطلوب
                    targetElement.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });

                    // 4. إغلاق المنيو تلقائياً بعد الانتقال ليرى العميل الصفحة
                    if (typeof toggleAlbarakaMenu === 'function') {
                        toggleAlbarakaMenu(false);
                    }
                } else {
                    console.log('القسم المطلوب غير موجود في هذه الصفحة:', targetSectionId);
                }
            }
        });
    });
});
