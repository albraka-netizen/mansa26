}
/* ========================================================
   ستـايل المنيو الثوري المليء بالحياة والنبض الحركي (Cyber-Vibrant)
   مع ترويسة وزر إغلاق فائق الفخامة والرقة
   ======================================================== */

/* 1. تأثير حركة الخلفية الدوارة لتعطي إحساساً دائماً بالنشاط والتجدد */
@keyframes cyberFluidGlow {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

/* 2. هيكل القائمة الجانبية: خلفية سائلة حية ومستقبلية تكسر الملل بالكامل */
.side-menu-container, 
[class*="side-menu"], 
[class*="sidebar"]:not(.sidebar-cart) {
    background: linear-gradient(
        -45deg, 
        rgba(15, 118, 110, 0.45), 
        rgba(13, 148, 136, 0.5), 
        rgba(254, 240, 138, 0.25),
        rgba(255, 255, 255, 0.55)
    ) !important;
    background-size: 400% 400% !important;
    animation: cyberFluidGlow 12s ease infinite !important; /* حركة التدرج اللوني الانسيابية ببطء خلف الأزرار */
    
    backdrop-filter: blur(35px) saturate(230%) !important; /* تصفية ونقاء فائق الجودة يعكس ألوان متجرك */
    -webkit-backdrop-filter: blur(35px) saturate(230%) !important;
    border-left: 1px solid rgba(255, 255, 255, 0.7) !important; /* خط رفيع بلوري دقيق */
    box-shadow: -15px 0 50px rgba(15, 118, 110, 0.1) !important;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1) !important; /* فتح وإغلاق انسيابي ناعم للغاية */
}

/* 3. [تحديث فاخر جداً] ترويسة المنيو المشرقة والمنسابة برقة مطلقة */
.side-menu-header,
[class*="menu-header"] {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    border-bottom: 1px solid rgba(15, 118, 110, 0.06) !important; /* خط سفلي دقيق شبه شفاف */
    padding: 24px 20px !important; /* توزيع أبعاد متناسق وأنيق */
    background: rgba(255, 255, 255, 0.25) !important; /* زجاج إضافي فائق النقاء للقسم العلوي */
    box-shadow: 0 4px 15px rgba(15, 118, 110, 0.02) !important;
}

.side-menu-header h3,
[class*="menu-header"] h3,
.side-menu-header *,
[class*="menu-header"] * {
    color: #042f2e !important; /* لون داكن عميق وواضح */
    font-weight: 900 !important;
    font-family: 'Cairo', sans-serif !important;
    font-size: 17px !important;
    letter-spacing: 0.5px !important;
    text-shadow: 0 2px 10px rgba(15, 118, 110, 0.12) !important;
}

/* 4. قائمة وحاوية الروابط الرفيعة */
.side-menu-ul, 
[class*="menu-ul"], 
[class*="side-menu"] ul {
    list-style: none !important;
    padding: 14px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 9px !important; /* أبعاد رشيقة تعطي واجهة مستخدم مريحة جداً */
}

/* 5. هندسة الأزرار الرفيعة والأنيقة (Slim Cyber Buttons) */
.side-menu-ul li a, 
[class*="menu-ul"] li a,
[class*="side-menu"] ul li a,
[class*="side-menu"] .menu-item {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 12px 16px !important; /* سمك رفيع ومريح جداً للأزرار */
    color: #0f766e !important; /* اللون الزمردي الأنيق */
    font-size: 14px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    border-radius: 14px !important; /* زوايا منحنية رشيقة ونحيفة */
    background: rgba(255, 255, 255, 0.65) !important; /* تداخل زجاجي ناصع نقي */
    border: 1px solid rgba(255, 255, 255, 0.8) !important;
    box-shadow: 0 4px 12px rgba(15, 118, 110, 0.03), inset 0 1px 2px rgba(255,255,255,0.9) !important;
    cursor: pointer !important;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1) !important; /* تفاعل حركي فائق الانسيابية والسلاسة */
}

/* 6. تأثير التمرير (Hover) - ينبض بالحداثة الفاخرة والطاقة المبهجة */
.side-menu-ul li a:hover, 
[class*="menu-ul"] li a:hover,
[class*="side-menu"] ul li a:hover,
[class*="side-menu"] .menu-item:hover {
    color: #ffffff !important; /* يتحول النص للبياض المشرق الفاخر */
    background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%) !important; /* تدرج مشع للزر عند التفاعل */
    border-color: #0f766e !important;
    transform: translateX(-6px) scale(1.02) !important; /* إزاحة حركية سلسة جداً لليمين تعطي إيحاء تفاعلي مميز */
    box-shadow: 0 12px 22px rgba(15, 118, 110, 0.25) !important;
}

/* 7. الأيقونات والإيموجي بالداخل لتكون ناعمة ومتفاعلة */
.side-menu-ul li a span,
[class*="menu-icon"],
[class*="menu-ul"] li a span {
    font-size: 16px !important;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
}

/* تفاعل الأيقونة بحركة نابضة بالحياة */
.side-menu-ul li a:hover span,
[class*="menu-ul"] li a:hover span,
[class*="menu-item"]:hover [class*="menu-icon"] {
    transform: scale(1.25) rotate(8deg) !important; /* تكبير رشيق وحركي للأيقونة يكسر جمود الأزرار */
}

/* 8. استجابة فيزيائية مرنة جداً عند النقر الفعلي بالإصبع على شاشات الهاتف (:active) */
.side-menu-ul li a:active,
[class*="menu-ul"] li a:active,
[class*="menu-item"]:active {
    transform: scale(0.95) translateX(-4px) !important; /* انضغاط تلميسي ذكي وناعم يعطي شعوراً فورياً بالاستجابة */
    background: #042f2e !important;
    color: #ffffff !important;
}

/* [تحديث ثوري ومميز جداً] زر إغلاق المنيو البلوري الأنيق الفخم (✕) */
.side-menu-header button,
[class*="menu-header"] button {
    background: rgba(15, 118, 110, 0.05) !important;
    border: 1px solid rgba(15, 118, 110, 0.15) !important;
    color: #0f766e !important;
    width: 34px !important;
    height: 34px !important;
    border-radius: 12px !important; /* زوايا منحنية رشيقة تناسب الأزرار وليست دائرة جامدة */
    font-size: 14px !important;
    font-weight: bold !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.6) !important;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important; /* حركة فيزيائية منسابة */
}

/* حركة التمرير المبهجة والمشعة لزر الإغلاق */
.side-menu-header button:hover,
[class*="menu-header"] button:hover {
    background: #ef4444 !important; /* يتحول للون الأحمر النيون الأنيق */
    color: #ffffff !important;
    border-color: #ef4444 !important;
    transform: rotate(90deg) scale(1.08) !important; /* يدور برقة ويكبر قليلاً للتفاعل البصري المميز */
    box-shadow: 0 6px 15px rgba(239, 68, 68, 0.3) !important;
}

/* ارتداد تلميسي ذكي لزر الإغلاق عند نقره على شاشة الهاتف */
.side-menu-header button:active,
[class*="menu-header"] button:active {
    transform: scale(0.9) rotate(90deg) !important; /* ينكمش بالإصبع ليعطيك إيحاء كأنه زر حقيقي */
}

/* هذا الكود يعالج مشكلة تقلص الهيدر والسلايدر على الهاتف */
